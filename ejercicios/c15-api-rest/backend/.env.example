NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

# Todavía no se usa desde el código (entra en C16 con Prisma), pero la db ya
# viaja en el docker-compose para no cambiar la infra en la próxima clase.
POSTGRES_USER=postgres
