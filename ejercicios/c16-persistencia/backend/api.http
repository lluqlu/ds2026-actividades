@baseUrl = http://localhost:3000

### Hello
GET {{baseUrl}}/

### ---------- LIBROS ----------

### Listar libros
GET {{baseUrl}}/api/libros

### Listar sólo disponibles
GET {{baseUrl}}/api/libros?disponible=true

### Ver un libro
GET {{baseUrl}}/api/libros/1

### Ver un libro que no existe -> 404
GET {{baseUrl}}/api/libros/9999

### Crear un libro -> 201
POST {{baseUrl}}/api/libros
Content-Type: application/json

{
  "titulo": "Rayuela",
  "autor": "Julio Cortázar",
  "precio": 18000,
  "imagen": "https://placehold.co/300x400?text=Libro",
  "disponible": true
}

### Actualizar un libro
PUT {{baseUrl}}/api/libros/1
Content-Type: application/json

{
  "titulo": "El principito (edición ilustrada)",
  "autor": "Antoine de Saint-Exupéry",
  "precio": 5200,
  "imagen": "https://placehold.co/300x400?text=Libro",
  "disponible": true
}

### Actualizar un libro que no existe -> 404
PUT {{baseUrl}}/api/libros/9999
Content-Type: application/json

{ "titulo": "x", "autor": "x", "precio": 1, "imagen": "x", "disponible": true }

### Borrar un libro -> 204
DELETE {{baseUrl}}/api/libros/10

### Borrar un libro que no existe -> 404
DELETE {{baseUrl}}/api/libros/9999

### ---------- AUTORES ----------

### Listar autores
GET {{baseUrl}}/api/autores

### Ver un autor
GET {{baseUrl}}/api/autores/1

### Ver un autor que no existe -> 404
GET {{baseUrl}}/api/autores/9999

### Crear un autor -> 201
POST {{baseUrl}}/api/autores
Content-Type: application/json

{ "nombre": "Julio Cortázar", "nacionalidad": "Argentina" }

### Actualizar un autor
PUT {{baseUrl}}/api/autores/1
Content-Type: application/json

{ "nombre": "Antoine de Saint-Exupéry", "nacionalidad": "Francesa" }

### Actualizar un autor que no existe -> 404
PUT {{baseUrl}}/api/autores/9999
Content-Type: application/json

{ "nombre": "x", "nacionalidad": "x" }

### Borrar un autor -> 204
DELETE {{baseUrl}}/api/autores/10

### Borrar un autor que no existe -> 404
DELETE {{baseUrl}}/api/autores/9999
