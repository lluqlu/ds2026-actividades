NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432

# Host "db" para correr todo en Docker; "localhost" para la CLI de Prisma
# desde la PC con sólo el contenedor db levantado.
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1

# AI-C18: secreto para firmar los JWT. Poné uno largo y aleatorio en tu .env.
JWT_SECRET=cambiame_por_una_cadena_larga_y_aleatoria
