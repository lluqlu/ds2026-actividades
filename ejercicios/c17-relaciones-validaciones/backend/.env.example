NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:5173

POSTGRES_USER=postgres
POSTGRES_PASSWORD=tu_password_segura
POSTGRES_DB=libreria_db
POSTGRES_PORT=5432

# Host "db" = nombre del servicio en docker-compose (para correr todo en Docker).
# Para correr Prisma CLI desde la PC con sólo el contenedor db levantado,
# cambiá "db" por "localhost" en tu .env local (nunca en este ejemplo).
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@db:${POSTGRES_PORT}/${POSTGRES_DB}

CHECKPOINT_DISABLE=1
PRISMA_HIDE_UPDATE_MESSAGE=1
